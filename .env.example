# ==========================
# KONFIGURASI SERVER
# ==========================
PORT=5000
BASE_URL=http://localhost:5000
NODE_ENV=development            # development | production | test
# Jika aplikasi berada di belakang reverse proxy (Nginx/Railway/Render), set jumlah proxy agar
# rate limiting membaca IP klien yang asli:
# TRUST_PROXY=1

# ==========================
# KONFIGURASI DATABASE MONGODB
# ==========================
MONGO_URI=mongodb://127.0.0.1:27017/hotel_booking_db

# ==========================
# KONFIGURASI JWT (JSON WEB TOKEN)
# WAJIB diisi. Server MENOLAK start jika kosong. Gunakan string acak minimal 32 karakter
# (di production nilai pendek / nilai contoh juga ditolak). Cara membuatnya:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ==========================
JWT_SECRET=ganti_dengan_secret_key_yang_sangat_rahasia
JWT_EXPIRES_IN=7d
# Masa berlaku token link invoice yang dikirim via WhatsApp
INVOICE_TOKEN_EXPIRES_IN=1h

# ==========================
# CORS - daftar origin frontend yang diizinkan (pisahkan dengan koma)
# Kosong: development = semua origin boleh, production = semua origin browser ditolak
# ==========================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ==========================
# RATE LIMITING (per IP)
# ==========================
RATE_LIMIT_WINDOW_MIN=15
AUTH_RATE_LIMIT_MAX=20          # login & registrasi
API_RATE_LIMIT_MAX=300          # endpoint API lainnya

# ==========================
# KONFIGURASI FONNTE (WHATSAPP NOTIFICATION API)
# Dapatkan token di https://fonnte.com setelah menghubungkan device WA
# ==========================
FONNTE_TOKEN=isi_dengan_token_fonnte_anda
