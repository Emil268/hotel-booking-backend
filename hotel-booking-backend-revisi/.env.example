# ==========================
# KONFIGURASI SERVER
# ==========================
PORT=5000
BASE_URL=http://localhost:5000

# ==========================
# KONFIGURASI DATABASE MONGODB
# ==========================
MONGO_URI=mongodb://127.0.0.1:27017/hotel_booking_db

# ==========================
# KONFIGURASI JWT (JSON WEB TOKEN)
# ==========================
JWT_SECRET=ganti_dengan_secret_key_yang_sangat_rahasia
JWT_EXPIRES_IN=7d

# ==========================
# KONFIGURASI FONNTE (WHATSAPP NOTIFICATION API)
# Dapatkan token di https://fonnte.com setelah menghubungkan device WA
# ==========================
FONNTE_TOKEN=isi_dengan_token_fonnte_anda
